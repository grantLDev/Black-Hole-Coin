# ---------------------------------------------------------------------------
# Singularity — environment variables
#
# Copy to .env.local for local development. In production these are set in
# Vercel -> Project -> Settings -> Environment Variables.
#
# NOTHING in this file is prefixed NEXT_PUBLIC_ except where explicitly noted.
# Unprefixed variables are readable ONLY inside serverless route handlers
# (app/api/**) and are never shipped to the browser. Do not import them from a
# client component, and never paste an RPC URL with an embedded key into
# client code.
# ---------------------------------------------------------------------------

# Helius — Solana RPC + DAS API. Used server-side to read holder counts and
# token supply for the mint. Free tier is enough for this site.
# Get one at https://dashboard.helius.dev (sign up, copy the key from the
# dashboard's "API Keys" panel). Paste ONLY the key here, not the whole URL —
# the route handlers build the RPC URL themselves.
HELIUS_API_KEY=

# Vercel KV (Upstash Redis) — persists the ratcheted all-time-high market cap
# and the holder-count peak across serverless invocations. Without these the
# peaks reset on every cold start and tiers would appear to un-unlock.
# Vercel dashboard -> Storage -> Create Database -> KV, then "Connect Project".
# Vercel injects these two automatically once connected; copy them into
# .env.local for local dev via `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Force the simulator even after the token launches. "1" enables demo mode.
# Public by design: the client must know which mode it is rendering.
NEXT_PUBLIC_DEMO_MODE=0

# Canonical origin, used for OpenGraph absolute URLs.
# e.g. https://singularity.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
